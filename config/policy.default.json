{
  "version": 3,
  "backend": {
    "enabled": true,
    "base_url": "https://opencode.ai/zen",
    "model": "jev-1.13-free",
    "api_key_env": "OPENCODE_API_KEY",
    "timeout_s": 5.0,
    "include_repo_signals": false
  },
  "scoring": {
    "under_penalty": 4.0,
    "over_penalty": 0.5,
    "tolerance": 0.5,
    "cost_weight": 0.6,
    "agent_cost": {
      "opencode": 0.25
    },
    "time_weight": 0.01,
    "min_confidence": 0.35
  },
  "dimensions": [
    {
      "id": "difficulty",
      "label": "难度",
      "type": "score",
      "weight": 1.0,
      "instructions": "How hard is this task for a capable coding agent?",
      "levels": [
        "Trivial: a one-line or purely mechanical change",
        "Easy: small, well-understood change in one place",
        "Moderate: needs some understanding of the surrounding code",
        "Hard: subtle logic, several interacting parts, or unclear root cause",
        "Expert: architecture, concurrency, security, or deep domain reasoning"
      ]
    },
    {
      "id": "duration",
      "label": "时长",
      "type": "score",
      "weight": 1.0,
      "instructions": "How long will a coding agent need to finish this task?",
      "levels": [
        "Under 5 minutes",
        "5 to 30 minutes",
        "30 to 120 minutes",
        "Several hours or more"
      ]
    },
    {
      "id": "scope",
      "label": "范围",
      "type": "score",
      "weight": 0.5,
      "instructions": "How much of the codebase does this task touch?",
      "levels": [
        "One spot in one file",
        "One file or one small component",
        "Several related files",
        "Many files across the codebase"
      ]
    },
    {
      "id": "task_type",
      "label": "类型",
      "type": "choice",
      "weight": 6.0,
      "instructions": "What kind of software task is this?",
      "options": {
        "implement": "Build a new feature or add new behaviour to code",
        "bugfix": "Find and fix a bug, crash, error, or regression",
        "refactor": "Mechanical restructuring: rename, migrate, reformat, bulk edits across files",
        "review": "Review existing code or a diff and report problems",
        "research": "Explain, investigate, or answer a question without changing code",
        "ui": "User interface, layout, styling, or front-end components",
        "test": "Write or fix automated tests",
        "docs": "Write or update documentation, comments, or changelogs"
      }
    }
  ],
